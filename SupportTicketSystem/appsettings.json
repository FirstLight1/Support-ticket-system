{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "Window": "00:01:00" },
    "Register": { "PermitLimit": 3, "Window": "00:10:00" },
    "Mutation": { "PermitLimit": 30, "Window": "00:01:00" }
  }
}
