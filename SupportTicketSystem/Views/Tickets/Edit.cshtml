@model EditTicketModel
@{
    ViewData["Title"] = "Edit ticket";
    Layout = "_Layout";
}

<div class="mb-4">
    <a class="btn btn-outline-secondary btn-sm" href="@ViewBag.ReturnUrl">← Back</a>
</div>

<h2 class="mb-4">Edit ticket</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Predmet" class="form-label">Subject</label>
                <input asp-for="Predmet" class="form-control" />
                <span asp-validation-for="Predmet" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TicketType" class="form-label">Ticket Type</label>
                <select asp-for="TicketType" asp-items="Html.GetEnumSelectList<TicketTypeEnum>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="TicketText" class="form-label">Ticket Text</label>
                <textarea asp-for="TicketText" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TicketText" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Severity" class="form-label"></label>
                <select asp-for="Severity" asp-items="Html.GetEnumSelectList<SeverityEnum>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="RelatedProject" class="form-label">Related project</label>
                <select asp-for="RelatedProject" asp-items="GitHubProjects.SelectList()" class="form-select">
                    <option value="">— None —</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label">Change Image</label>
                <input asp-for="Image" class="change-image-input" accept="image/*" />
                <div class="image-div">
                    <img src="@Model.ImagePath" width="300" class="image" />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success" asp-route-id="@Model.TicketId">Save</button>
                <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
    <script>
        const imageDiv = document.querySelector('.image-div');
        const input = document.querySelector('.change-image-input');
        const image = document.querySelector('.image');


        input.addEventListener('change', (e) => {
            const newImage = input.files[0];
            if(!newImage) return;
            image.src = URL.createObjectURL(newImage);
        })
    </script>