@model List<Tickets>
@{
    ViewData["Title"] = "Tickets";
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>title</title>
</head>
<body>
<div>
    <button class="btn"><a class="text-decoration-none text-black" asp-action="Create">Vytvorit ticket</a></button>
</div>
<div>
    @foreach (var ticket in Model)
    {
        <div>
            <p>@ticket.Predmet</p>
            <p>@ticket.TicketType</p>
            <p class="@ticket.Severity">@ticket.Severity</p>
            <p>@ticket.CreatedByUserId</p>
            <button class="btn"><a class="text-decoration-none" asp-action="Details" asp-route-id="@ticket.TicketId">Details</a></button>
            <button class="btn"><a class="text-decoration-none" asp-action="Edit" asp-route-id="@ticket.TicketId">Edit</a></button>
            <form asp-action="Delete" asp-route-ticketId="@ticket.TicketId" method="post">
                <button type="submit" class="btn">Delete</button>
            </form>        
            </div>
    }
</div>
</body>
</html>