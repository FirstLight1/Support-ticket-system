@model Tickets
@{
    ViewData["Title"] = "Create ticket";
    Layout = "_Layout";
}

<div class="mb-4">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Back</a>
</div>

<h2 class="mb-4">Create ticket</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Predmet" class="form-label">Subject</label>
                <input asp-for="Predmet" class="form-control" />
                <span asp-validation-for="Predmet" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TicketType" class="form-label">Ticket Type</label>
                <select asp-for="TicketType" asp-items="Html.GetEnumSelectList<TicketTypeEnum>()" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="TicketText" class="form-label">Ticket Text</label>
                <textarea asp-for="TicketText" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TicketText" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Severity" class="form-label"></label>
                <select asp-for="Severity" asp-items="Html.GetEnumSelectList<SeverityEnum>()" class="form-select"></select>
            </div>
            
            <div class="mb-3">
                <label asp-for="Image" class="form-label"></label>
                <input asp-for="Image" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>