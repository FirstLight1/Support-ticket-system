@model Tickets
@{
    ViewData["Title"] = "Ticket detail";
    Layout = "_Layout";
}

<div class="mb-4">
    <a class="btn btn-outline-secondary btn-sm" href="@ViewBag.ReturnUrl">← Back</a>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@Model.Predmet</h4>
        @{
            var badgeClass = Model.Severity switch
            {
                SeverityEnum.Critical => "bg-danger",
                SeverityEnum.High => "bg-warning text-dark",
                SeverityEnum.Medium => "bg-info text-dark",
                _ => "bg-secondary"
            };
        }
        <span class="badge @badgeClass">@Model.Severity</span>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <strong>Ticket type</strong>
                <p>@Model.TicketType</p>
            </div>
            <div class="col-md-4">
                <strong>Status</strong>
                <p>@Model.Status</p>
            </div>
            <div class="col-md-4">
                <strong>Date</strong>
                <p>@DateTimeOffset.Parse(Model.DatumVytvorenia).ToString("dd.MM.yyyy HH:mm")</p>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.RelatedProject))
        {
            var projectUrl = GitHubProjects.UrlFor(Model.RelatedProject);
            <div class="mb-3">
                <strong>Related project</strong>
                <p class="mb-0">
                    @if (projectUrl != null)
                    {
                        <a href="@projectUrl" target="_blank" rel="noopener noreferrer">@Model.RelatedProject</a>
                    }
                    else
                    {
                        @Model.RelatedProject
                    }
                </p>
            </div>
        }
        <hr />
        <strong>Description</strong>
        <p>@Model.TicketText</p>

        @if (Model.ImagePath != null)
        {
            <img src="@Model.ImagePath" width="400px" alt="Ticket image" />
        }

        @if (Model.Status == TicketStatusEnum.Completed && !string.IsNullOrEmpty(Model.CompletionNote))
        {
            <hr />
            <div class="alert alert-success mt-3">
                <strong>Completion note</strong>
                <p class="mb-0 mt-1">@Model.CompletionNote</p>
            </div>
        }
    </div>

    @if (Model.Status != TicketStatusEnum.Completed)
    {
        <div class="card-footer d-flex gap-2">
            <a class="btn btn-outline-secondary"
               href="/Tickets/Edit/@Model.TicketId?returnUrl=@ViewBag.ReturnUrl">Edit</a>
            <form asp-action="Delete" asp-route-ticketId="@Model.TicketId"
                  asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        </div>
    }
</div>

