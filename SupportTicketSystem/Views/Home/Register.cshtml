@model SupportTicketSystem.Models.RegisterViewModel

@{
    ViewBag.Title = "Register";
    Layout = "_Layout";
}

<h2>Register</h2>
<div>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <label asp-for="Email">Email</label>
        <input asp-for="Email" placeholder="example@example.com" class="form-control mb-2" />
        <span asp-validation-for="Email" class="text-danger"></span>
            
        <label asp-for="Password">Password</label>
        <input asp-for="Password" class="form-control mb-2" />
        <span asp-validation-for="Password" class="text-danger"></span>
        
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <input asp-for="ConfirmPassword" class="form-control mb-2" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        
        <button type="submit" class="btn btn-success mt-2">Register</button>
    </form>
</div>