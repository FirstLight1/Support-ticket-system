{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "logs/app-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14
              }
            }
          ]
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "Window": "00:01:00" },
    "Register": { "PermitLimit": 3, "Window": "00:10:00" },
    "Mutation": { "PermitLimit": 30, "Window": "00:01:00" }
  },
  "Security": {
    "Lockout": { "MaxFailedAttempts": 5, "LockoutDuration": "00:15:00" }
  }
}
